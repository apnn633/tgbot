# ===========================================
# 丛雨 Telegram Bot 配置文件
# ===========================================

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_bot_token_here

# === Webhook (可选) ===
# 仅在使用 webhook 模式时需要
# WEBHOOK_URL=https://your-tunnel-url.trycloudflare.com
# WEBHOOK_PORT=8443
# WEBHOOK_SECRET=your_webhook_secret_here

# ============ 认证配置 ============
# 白名单用户ID（逗号分隔，留空则所有人需要配对码认证）
ALLOWED_USER_IDS=
# 配对码有效期（秒）
PAIRING_CODE_TTL=300

# ===========================================
# 对话 API 配置 (DeepSeek / OpenAI 兼容)
# 用于文字对话和生成丛雨风格回复
# ===========================================
CHAT_API_KEY=your_chat_api_key_here
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini

# ===========================================
# 多模态 API 配置 (无问芯穹 GenStudio)
# 用于图像识别、视频分析
# 文档: https://docs.infini-ai.com/gen-studio/api/tutorial-vision.html
# ===========================================
# 多模态模式:
#   "auto" - 自动选择：对话AI配置则两步模式，否则使用多模态AI直接回复
#   "two_step" - 两步模式：多模态AI分析 -> 对话AI生成回复（需同时配置两个API）
#   "direct" - 直接模式：多模态AI直接回复（只需配置多模态API）
#   "disabled" - 禁用：不支持图片/视频（只需配置对话API）
MULTIMODAL_MODE=auto
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=https://cloud.infini-ai.com/maas/v1
# 视觉模型选择:
# Qwen系列 (只支持Base64，图片/视频限制5MB):
#   - qwen2.5-vl-7b-instruct
#   - qwen2.5-vl-32b-instruct
#   - qwen2.5-vl-72b-instruct
#   - qwen3-vl-plus (推荐)
#   - qwen3-vl-235b-a22b-instruct
#   - qwen3-vl-235b-a22b-thinking
# GLM系列 (支持URL，图片限制5MB，视频限制200MB):
#   - glm-4.5v
#   - glm-4.6v
# 注意: GLM系列不是多模态对话模型，仅用于图像理解
MULTIMODAL_MODEL=qwen3-vl-plus
# 强制使用 Base64 传输图片/视频（解决 URL 访问失败问题）
# GLM 模型支持 URL 模式，但如果 URL 无法访问会自动回退到 Base64
# 设为 true 可跳过 URL 尝试，直接使用 Base64
FORCE_BASE64_IMAGE=false

# ===========================================
# STT API 配置 (语音识别)
# ===========================================
# STT服务类型: "openai" 或 "xunfei"
STT_PROVIDER=openai

# OpenAI Whisper
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# 讯飞语音听写（流式版）
# 文档: https://www.xfyun.cn/doc/asr/voicedictation/API.html
# 支持60秒以内音频，中文/英文/方言
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

# ===========================================
# TTS API 配置 (语音合成)
# ===========================================
# TTS服务类型: "openai" 或 "inworld"
TTS_PROVIDER=openai

# OpenAI TTS
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=shimmer

# InworldTTS (日语克隆语音)
# 文档: https://docs.inworld.ai/docs/tts/voice-cloning
# 需要先在Portal创建语音获取voiceId
INWORLD_API_KEY=
INWORLD_VOICE_ID=

# TTS输出模式
# "llm_output" - AI直接输出JSON格式 {"zh": "中文", "ja": "日语"}，效率高
# "translate" - 先生成中文，再翻译成日语
TTS_OUTPUT_MODE=llm_output

# ===========================================
# 搜索 API 配置 (SerpAPI)
# 用于天气查询等功能
# 文档: https://serpapi.com/search-api
# ===========================================
ENABLE_SEARCH=false
SERPAPI_API_KEY=

# ===========================================
# API 调用设置
# ===========================================
# API 超时时间（秒）
API_TIMEOUT=60.0
# API 最大重试次数
API_MAX_RETRIES=3

# ===========================================
# 其他设置
# ===========================================
MAX_TOKENS=1000

# ===========================================
# 日志配置
# ===========================================
# 美化日志输出（带颜色）
LOG_PRETTY=true
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO